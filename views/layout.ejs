<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#050505">

<title><%= seo.title %></title>
<meta name="description" content="<%= seo.desc %>">
<link rel="canonical" href="<%= SITE + seo.path %>">
<meta property="og:type" content="<%= seo.ogType || 'website' %>">
<meta property="og:locale" content="fa_IR">
<meta property="og:site_name" content="سیگنال هوش">
<meta property="og:title" content="<%= seo.title %>">
<meta property="og:description" content="<%= seo.desc %>">
<meta property="og:url" content="<%= SITE + seo.path %>">
<meta property="og:image" content="<%= SITE + (seo.image || ASSETS.og_default) %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:image" content="<%= SITE + (seo.image || ASSETS.og_default) %>">
<meta name="twitter:card" content="summary_large_image">
<% if (seo.noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
<% if (typeof jsonld !== 'undefined' && jsonld) { %>
<script type="application/ld+json"><%- JSON.stringify(jsonld) %></script>
<% } %>

<script>(function(){try{var t=localStorage.getItem("sh_theme");if(t!=="light"&&t!=="dark"){t=(window.matchMedia&&window.matchMedia("(prefers-color-scheme: light)").matches)?"light":"dark";}if(t==="light"){document.documentElement.setAttribute("data-theme","light");}}catch(e){}})();</script>

<link rel="stylesheet" href="<%= ASSETS.tokens %>">
<link rel="stylesheet" href="<%= ASSETS.base %>">
<link rel="stylesheet" href="<%= ASSETS.components %>">

<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='%234f83f7'/><stop offset='1' stop-color='%239b7cfc'/></linearGradient></defs><rect width='32' height='32' rx='8' fill='url(%23g)'/><text x='50%25' y='56%25' dominant-baseline='middle' text-anchor='middle' font-size='17' font-weight='700' fill='white' font-family='system-ui'>S</text></svg>">
</head>
<body>

<a class="skip-link" href="#main">رفتن به محتوا</a>

<header class="topbar">
  <div class="container">
    <a class="logo" href="/">
      <div class="logo-mark">S</div>
      <div class="logo-text">سیگنال<span> هوش</span></div>
    </a>
    <div class="topbar-meta">
      <span class="live"><span class="live-dot"></span> زنده</span>
      <span class="clock" id="clock">--:--</span>
      <button class="theme-btn" aria-label="تم روشن">
        <svg class="i-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
        <svg class="i-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>

<%# صفحه‌های پنل مدیریت با seo.bare می‌آیند: نه نوار تب سایت را لازم دارند
    نه فوتر عمومی را. لینک بازگشت به سایت داخل خود پنل هست. %>
<% if (!seo.bare) { %>
<nav class="tabbar" aria-label="بخش‌ها">
  <div class="container">
    <div class="tabs">
      <% TABS.forEach(function (t) { %>
      <a class="tab" href="<%= t.href %>"<%- t.href === active ? ' aria-current="page"' : '' %>><%= t.label %></a>
      <% }); %>
    </div>
  </div>
</nav>
<% } %>

<%- body %>

<% if (!seo.bare) { %>
<footer class="footer">
  <div class="disc">
    <div class="container">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      <p><strong>توجه:</strong> تمام اطلاعات این سایت به‌صورت خودکار از منابع عمومی و در دسترس اینترنت جمع‌آوری می‌شود. سیگنال هوش ناشر یا مالک این محتوا نیست و مسئولیتی درباره‌ی صحت یا عواقب استفاده از آن نمی‌پذیرد. برای درخواست حذف داده <a href="/contact">با ما تماس بگیرید</a>.</p>
    </div>
  </div>

  <div class="footer-main">
    <div class="container">
      <div class="footer-grid">
        <div>
          <a class="logo" href="/">
            <div class="logo-mark logo-mark-sm">S</div>
            <div class="logo-text">سیگنال<span> هوش</span></div>
          </a>
          <p class="footer-about">
            سیگنال هوش، مانیتور هوشمند ایران است: قیمت لحظه‌ای دلار، طلا، سکه و ارز دیجیتال،
            ترند جستجوی گوگل، اخبار کانال‌های تلگرام، قیمت روز خودرو، پرفروش‌های بازار کالا و
            آمار بازار کار — همه رایگان و بدون ثبت‌نام.
          </p>
        </div>
        <div>
          <h4>بخش‌ها</h4>
          <ul>
            <li><a href="/trends">ترند سرچ ایران</a></li>
            <li><a href="/news">ترند اخبار ایران</a></li>
            <li><a href="/finance">ترند بازارهای مالی</a></li>
            <li><a href="/cars">ترند خودرو ایران</a></li>
          </ul>
        </div>
        <div>
          <h4>بازارها</h4>
          <ul>
            <li><a href="/market">ترند کالای ایران</a></li>
            <li><a href="/jobs">مارکت کار ایران</a></li>
            <li><a href="/polymarket">ترند های پلی مارکت</a></li>
            <li><a href="/future">ترند آینده</a></li>
          </ul>
        </div>
        <div>
          <h4>درباره</h4>
          <ul>
            <li><a href="/contact">ارتباط با ما</a></li>
            <li><a href="https://t.me/signalhoosh" target="_blank" rel="noopener">کانال تلگرام ما</a></li>
            <li><a href="/news/archive">بایگانی اخبار</a>
        <a href="/disclaimer">سلب مسئولیت</a></li>
            <li><a href="/disclaimer#removal">درخواست حذف داده</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <span>© ۱۴۰۵ سیگنال هوش</span>
      <span>داده‌ها از منابع عمومی اینترنت</span>
    </div>
  </div>
</footer>
<% } %>

<script src="<%= ASSETS.app %>"></script>

<% if (!seo.noindex) { %>
<!-- Google Analytics — فقط روی صفحات عمومی، نه پنل مدیریت -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-DWN8J1WHYH"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-DWN8J1WHYH');
</script>
<% } %>
</body>
</html>
