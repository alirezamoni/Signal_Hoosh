<main id="main" class="page">
  <div class="container">
    <nav class="crumb"><a href="/">خانه</a> <span>/</span> <span>ترند خودرو ایران</span></nav>

    <div class="page-head between wrap">
      <div>
        <h1 class="page-title">ترند بازار خودرو ایران</h1>
        <p class="page-sub">داده هر ۱۲ ساعت ثبت می‌شود · واحد: تومان</p>
      </div>
      <div class="row wrap" style="gap:6px;">
        <span class="tag"><%= fa(stats.models || 0) %> مدل</span>
        <span class="tag"><%= fa(stats.snapshots || 0) %> اسنپ‌شات</span>
        <span class="tag"><%= fa(stats.days || 0) %> روز داده</span>
      </div>
    </div>

    <blockquote class="desc">
      تحلیل روند بازار خودرو ایران بر پایه داده‌های خرید و فروش. این بخش تغییرات قیمت، حجم آگهی‌ها،
      خودروهای داغ بازار و روند عرضه و تقاضا را نمایش می‌دهد. با توجه به اینکه خودرو در سال‌های اخیر
      علاوه بر یک کالای مصرفی، به یکی از دارایی‌های سرمایه‌ای (Investment Asset) در ایران تبدیل شده
      است، رصد این شاخص‌ها می‌تواند تصویری از انتظارات تورمی، رفتار سرمایه‌گذاران و جهت حرکت
      نقدینگی در اقتصاد ارائه دهد.
    </blockquote>

    <div class="grid g6 mb6">
      <div class="kpi"><div class="kpi-label">مدل‌های رصد شده</div><div class="kpi-val"><%= fa(stats.models || 0) %></div><div class="kpi-note"><%= fa(totalListings) %> آگهی نمونه</div></div>
      <div class="kpi"><div class="kpi-label">بیشترین رشد قیمت</div><div class="kpi-val fa"><%= topGain ? topGain.name_fa : '—' %></div><div class="kpi-note up"><%= topGain ? '▲ ' + fa(Math.abs(topGain.pct_per_day).toFixed(2)) + '٪ در روز' : '' %></div></div>
      <div class="kpi"><div class="kpi-label">بیشترین افت قیمت</div><div class="kpi-val fa"><%= topLoss ? topLoss.name_fa : '—' %></div><div class="kpi-note down"><%= topLoss ? '▼ ' + fa(Math.abs(topLoss.pct_per_day).toFixed(2)) + '٪ در روز' : '' %></div></div>
      <div class="kpi"><div class="kpi-label">گران‌ترین برند</div><div class="kpi-val fa"><%= priciest ? priciest.name_fa : '—' %></div><div class="kpi-note"><%= priciest ? fa(toman(priciest.median_price)) + ' تومان' : '' %></div></div>
      <div class="kpi"><div class="kpi-label">ارزان‌ترین برند</div><div class="kpi-val fa"><%= cheapest ? cheapest.name_fa : '—' %></div><div class="kpi-note"><%= cheapest ? fa(toman(cheapest.median_price)) + ' تومان' : '' %></div></div>
      <div class="kpi"><div class="kpi-label">آخرین بروزرسانی</div><div class="kpi-val fa"><%= faDay(stats.last_day) %></div><div class="kpi-note">هر ۱۲ ساعت</div></div>
    </div>

    <div class="page-head"><h2 class="sec-title">وضعیت فعلی بازار</h2></div>

    <div class="car-grid mb6">
      <% cars.forEach(function (c) { %>
      <a class="car-card" href="<%= c.url || '#' %>" target="_blank" rel="noopener">
        <% if (c.image_url) { %>
        <img class="car-img" src="<%= c.image_url %>" alt="<%= c.name_fa %>" loading="lazy">
        <% } %>
        <div class="car-name"><%= c.name_fa %></div>
        <div class="car-price"><%= fa(toman(c.median_price)) %></div>
        <div class="row wrap mt3" style="gap:5px;">
          <% if (c.change_day_pct != null) { %>
          <span class="badge <%= c.change_day_pct > 0 ? 'badge-up' : (c.change_day_pct < 0 ? 'badge-down' : 'badge-flat') %>"><%= pct(c.change_day_pct) %> روز</span>
          <% } %>
          <span class="tag"><%= c.tier === 'high' ? 'لوکس' : (c.tier === 'mid' ? 'میان‌رده' : 'اقتصادی') %></span>
        </div>
        <div class="car-meta">
          <span>کارکرد <%= fa(num(c.avg_mileage)) %></span>
          <span><%= fa(num(c.listing_count)) %> آگهی</span>
        </div>
      </a>
      <% }); %>
      <% if (!cars.length) { %><div class="panel"><div class="panel-body-pad dim">داده‌ای موجود نیست</div></div><% } %>
    </div>

    <% if (submodels.length) { %>
    <div class="page-head"><h2 class="sec-title">تنوع مدل‌ها و زیرمدل‌ها</h2></div>
    <blockquote class="desc">
      میانگین قیمت و کارکرد هر تریم/نسخه مستقیماً از آمار دیوار روی کل آگهی‌های آن برند می‌آید،
      نه فقط نمونه‌ی محدود ما — تصویر کامل‌تری از تنوع بازار هر برند می‌دهد.
    </blockquote>
    <% submodelGroups.forEach(function (g) { %>
    <div class="sub-brand">
      <h3 class="sub-brand-name"><%= g.name %></h3>
      <span class="tag"><%= g.tier === 'high' ? 'لوکس' : (g.tier === 'mid' ? 'میان‌رده' : 'اقتصادی') %></span>
      <span class="dim" style="font-size:var(--fs-xs);"><%= fa(g.total) %> زیرمدل در بازار</span>
    </div>
    <div class="sm-grid">
      <% g.top.forEach(function (sm) { %>
      <div class="sm-row">
        <% if (sm.image_url) { %><img class="sm-thumb" src="<%= sm.image_url %>" alt="<%= sm.name_fa %>" loading="lazy" width="44" height="32"><% } else { %><span class="sm-thumb sm-thumb-ph"></span><% } %>
        <span class="sm-name" title="<%= sm.name_fa %>"><%= sm.name_fa %></span>
        <span class="sm-num">
          <span class="sm-price"><%= fa(toman(sm.avg_price)) %></span>
          <span class="sm-km">کارکرد <%= fa(num(sm.avg_mileage)) %></span>
        </span>
      </div>
      <% }); %>
    </div>
    <% if (g.rest.length) { %>
    <details class="sm-more">
      <summary><span class="sm-more-open">نمایش <%= fa(g.rest.length) %> زیرمدل دیگر <%= g.name %></span><span class="sm-more-close">بستن فهرست <%= g.name %></span></summary>
      <div class="sm-grid mt3">
        <% g.rest.forEach(function (sm) { %>
        <div class="sm-row">
          <% if (sm.image_url) { %><img class="sm-thumb" src="<%= sm.image_url %>" alt="<%= sm.name_fa %>" loading="lazy" width="44" height="32"><% } else { %><span class="sm-thumb sm-thumb-ph"></span><% } %>
          <span class="sm-name" title="<%= sm.name_fa %>"><%= sm.name_fa %></span>
          <span class="sm-num">
            <span class="sm-price"><%= fa(toman(sm.avg_price)) %></span>
            <span class="sm-km">کارکرد <%= fa(num(sm.avg_mileage)) %></span>
          </span>
        </div>
        <% }); %>
      </div>
    </details>
    <% } %>
    <% }); %>
    <% } %>

    <% if (tiers.length) { %>
    <div class="page-head"><h2 class="sec-title">قیمت بر کارکرد — مقایسه رده‌ها</h2></div>
    <blockquote class="desc">
      «قیمت بر کارکرد» یعنی به ازای هر کیلومتر کارکردِ خودرو، چند تومان بابت قیمت آن می‌پردازید.
      عدد کمتر یعنی خودرو نسبت به کارکردی که دارد ارزان‌تر است. این مقایسه فقط <strong>داخل هر رده</strong>
      معنا دارد، چون یک خودروی لوکس ذاتاً قیمت‌بر‌کارکرد بالاتری از یک خودروی اقتصادی دارد.
      خط عمودی روی هر میله، میانگین همان رده است؛ میله‌ی سبز یعنی به‌صرفه‌تر از میانگین رده.
    </blockquote>

    <div class="grid g3 mb6">
      <% tiers.forEach(function (t) { %>
      <section class="panel">
        <div class="panel-head">
          <h3 class="panel-title"><%= t.label %></h3>
          <span class="panel-link">میانگین رده: <%= fa(num(t.avg)) %></span>
        </div>
        <div class="panel-body">
          <% t.items.forEach(function (it) { %>
          <div class="drow" style="display:block;">
            <div class="between" style="margin-bottom:6px;">
              <span class="drow-name"><%= it.name_fa %></span>
              <div class="drow-val">
                <span><%= fa(num(it.price_per_km)) %></span>
                <span class="drow-sub">تومان/کیلومتر</span>
              </div>
            </div>
            <div class="ppk-bar">
              <div class="ppk-fill <%= it.value_vs_tier_pct < 0 ? 'good' : 'bad' %>" style="width:<%= it.widthPct %>%;"></div>
              <span class="ppk-avg" style="right:<%= t.avgPct %>%;" title="میانگین رده"></span>
            </div>
          </div>
          <% }); %>
        </div>
        <div class="panel-foot"><%= fa(t.items.length) %> مدل در این رده</div>
      </section>
      <% }); %>
    </div>
    <% } %>

    <% if (series.length) { %>
    <div class="page-head between wrap">
      <h2 class="sec-title">روند قیمت در طول زمان</h2>
      <span class="tag">از <%= faDay(stats.first_day) %></span>
    </div>
    <blockquote class="desc">
      میانه‌ی قیمت آگهی‌های هر مدل، دو بار در روز ثبت می‌شود. چون تعداد و ترکیب آگهی‌ها
      هر بار فرق می‌کند، نوسان روزانه طبیعی است؛ آنچه اهمیت دارد جهت کلی خط است نه تک‌نقطه‌ها.
    </blockquote>

    <div class="grid g3 mb6">
      <% series.forEach(function (s) { %>
      <section class="panel">
        <div class="panel-head">
          <h3 class="panel-title">
            <% if (s.image_url) { %><img class="thumb-sm" src="<%= s.image_url %>" alt="<%= s.name_fa %>" loading="lazy"><% } %>
            <%= s.name_fa %>
          </h3>
          <% if (s.changePct != null) { %>
          <span class="badge <%= s.changePct > 0 ? 'badge-up' : (s.changePct < 0 ? 'badge-down' : 'badge-flat') %>"><%= pct(s.changePct) %></span>
          <% } %>
        </div>
        <div class="panel-body-pad">
          <svg class="spark-lg" viewBox="0 0 220 44" preserveAspectRatio="none" role="img" aria-label="روند قیمت <%= s.name_fa %>">
            <polyline points="<%= s.spark %>" fill="none" stroke="<%= s.changePct > 0 ? 'var(--up)' : (s.changePct < 0 ? 'var(--down)' : 'var(--dim)') %>" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
          </svg>
          <div class="between mt3" style="font-size:var(--fs-xs);">
            <span class="dim">آغاز: <%= fa(toman(s.first)) %></span>
            <span class="dim">اکنون: <%= fa(toman(s.last)) %></span>
          </div>
        </div>
        <div class="panel-foot"><%= s.tierLabel %> · <%= fa(s.points) %> اندازه‌گیری</div>
      </section>
      <% }); %>
    </div>
    <% } %>

    <div class="page-head"><h2 class="sec-title">سرعت رشد و صرفه اقتصادی</h2></div>
    <blockquote class="desc">
      «سرعت رشد» یعنی به‌طور میانگین قیمت هر روز چند درصد تغییر کرده (شتاب بازار، نه فقط جهتش).
      «صرفه نسبت به رده» یعنی قیمت‌بر‌کارکرد این مدل چقدر از میانگین هم‌رده‌اش کمتر یا بیشتر است —
      منفی یعنی به‌صرفه‌تر از رقبای هم‌رده.
    </blockquote>

    <% if (scatter) { %>
    <section class="panel mb4">
      <div class="panel-head">
        <h3 class="panel-title">جایگاه هر خودرو در دو محور</h3>
        <span class="panel-link">ربع بالا-راست بهترین است</span>
      </div>
      <div class="panel-body-pad">
        <div class="scatter-wrap">
          <svg class="scatter" viewBox="0 0 100 100" role="img" aria-label="پراکندگی سرعت رشد در برابر صرفه اقتصادی">
            <line x1="50" y1="2" x2="50" y2="98" stroke="var(--border-strong)" stroke-width="0.4"/>
            <line x1="2" y1="50" x2="98" y2="50" stroke="var(--border-strong)" stroke-width="0.4"/>
            <% scatter.items.forEach(function (p) { %>
            <circle cx="<%= p.x %>" cy="<%= p.y %>" r="2.2"
                    fill="<%= p.value_vs_tier_pct < 0 ? 'var(--up)' : 'var(--down)' %>">
              <title><%= p.name_fa %> — رشد <%= fa(p.pct_per_day.toFixed(2)) %>٪ در روز، صرفه <%= pct(p.value_vs_tier_pct) %></title>
            </circle>
            <text x="<%= p.x %>" y="<%= (Number(p.y) - 3.6).toFixed(1) %>" text-anchor="middle"
                  font-size="3.1" fill="var(--muted)"><%= p.name_fa %></text>
            <% }); %>
          </svg>
          <span class="scatter-ax scatter-ax-t">به‌صرفه‌تر از رده</span>
          <span class="scatter-ax scatter-ax-b">گران‌تر از رده</span>
          <span class="scatter-ax scatter-ax-r">قیمت رو به رشد ←</span>
          <span class="scatter-ax scatter-ax-l">→ قیمت رو به کاهش</span>
        </div>
      </div>
      <div class="panel-foot">
        محور افقی سرعت رشد قیمت (درصد در روز) و محور عمودی صرفه نسبت به میانگین رده است.
        نقطه‌ی سبز یعنی نسبت به هم‌رده‌هایش به‌صرفه‌تر است.
      </div>
    </section>
    <% } %>

    <div class="tbl-wrap">
      <table>
        <thead><tr><th class="rank-cell">#</th><th>خودرو</th><th class="ta-l">رده</th><th class="ta-l">میانه قیمت</th><th class="ta-l">قیمت بر کارکرد</th><th class="ta-l">سرعت رشد (٪ در روز)</th><th class="ta-l">صرفه نسبت به رده</th></tr></thead>
        <tbody>
          <% metrics.forEach(function (m, i) { %>
          <tr>
            <td class="rank-cell"><%= fa(i + 1) %></td>
            <td class="td-name"><span class="row"><% if (m.image_url) { %><img class="thumb-sm" src="<%= m.image_url %>" alt="<%= m.name_fa %>" loading="lazy"><% } %><%= m.name_fa %></span></td>
            <td class="ta-l"><span class="tag"><%= m.tier === 'high' ? 'لوکس' : (m.tier === 'mid' ? 'میان‌رده' : 'اقتصادی') %></span></td>
            <td class="ta-l"><%= fa(num(m.median_price)) %></td>
            <td class="ta-l"><%= fa(num(m.price_per_km)) %></td>
            <td class="ta-l"><% if (m.pct_per_day != null) { %><span class="badge <%= m.pct_per_day > 0 ? 'badge-up' : (m.pct_per_day < 0 ? 'badge-down' : 'badge-flat') %>"><%= (m.pct_per_day > 0 ? '+' : m.pct_per_day < 0 ? '−' : '') + fa(Math.abs(m.pct_per_day).toFixed(2)) %></span><% } else { %>—<% } %></td>
            <td class="ta-l"><% if (m.value_vs_tier_pct != null) { %><span class="badge <%= m.value_vs_tier_pct < 0 ? 'badge-up' : 'badge-down' %>"><%= pct(m.value_vs_tier_pct) %></span><% } else { %>—<% } %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <p class="dim mt3" style="font-size:var(--fs-xs);">
      قیمت‌ها میانه‌ی آگهی‌های ثبت‌شده است و قیمت قطعی معامله محسوب نمی‌شود.
    </p>

  </div>
</main>
