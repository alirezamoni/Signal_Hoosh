<main id="main" class="page">
  <div class="container">
    <nav class="crumb"><a href="/">خانه</a> <span>/</span> <span>ترند بازارهای مالی</span></nav>

    <div class="page-head">
      <h1 class="page-title">ترند بازارهای مالی ایران</h1>
      <p class="page-sub">دلار آزاد، طلا، سکه و انس جهانی · بروزرسانی هر ۱۰ دقیقه · قیمت‌ها به تومان، مگر آنکه واحد دیگری کنار عدد آمده باشد</p>
    </div>

    <blockquote class="desc">
      رصد و تحلیل لحظه‌ای بازارهای موازی ایران با تمرکز بر دلار آزاد، طلا، سکه و انس جهانی.
      این داشبورد قیمت‌های جاری، روندهای کوتاه‌مدت و بلندمدت و جریان اخبار مالی را در یک نمای
      واحد ترکیب می‌کند. بررسی هم‌زمان این شاخص‌ها امکان شناسایی تغییر مسیر نقدینگی، سنجش
      احساسات بازار و تحلیل ارتباط میان اخبار، انتظارات اقتصادی و نوسانات قیمتی را فراهم می‌سازد.
      این داده از دو کانال نیمه رسمی (سایت‌های معتبر) و کاملاً غیررسمی (کانال‌های تلگرامی کف بازار)
      جمع‌آوری می‌شود.
    </blockquote>

    <div class="grid g4 mb4">
      <% kpi.forEach(function (f) {
           var p = sparkPath(f.hist, 200, 42, 4);
           var a = sparkArea(f.hist, 200, 42, 4);
           var up = trendDir(f.hist) >= 0;
           var col = up ? 'var(--up)' : 'var(--down)';
      %>
      <div class="kpi <%= p ? 'kpi-spark' : '' %>">
        <div class="kpi-head"><span class="kpi-name"><%= f.name || f.symbol %></span></div>
        <div class="kpi-val"><%= fa(f.priceText) %><% if (f.unitText !== 'تومان') { %><span class="tick-unit"><%= f.unitText %></span><% } %></div>
        <div class="kpi-note <%= f.change_pct > 0 ? 'up' : (f.change_pct < 0 ? 'down' : '') %>">
          <%= f.change_pct > 0 ? '▲' : (f.change_pct < 0 ? '▼' : '—') %> <%= fa(num(Math.abs(f.change || 0))) %> (<%= pct(f.change_pct) %>)
        </div>
        <div class="kpi-note">کمترین <%= fa(num(f.low)) %> · بیشترین <%= fa(num(f.high)) %></div>
        <% if (f.bubble) { %><div class="kpi-note">حباب: <span class="<%= f.bubble > 0 ? 'up' : 'down' %>"><%= fa(num(f.bubble)) %></span></div><% } %>
        <% if (p) { %>
        <svg class="spark-bg" viewBox="0 0 200 42" preserveAspectRatio="none" aria-hidden="true">
          <path d="<%= a %>" fill="<%= col %>" opacity=".16"/>
          <path d="<%= p %>" fill="none" stroke="<%= col %>" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
        <% } %>
      </div>
      <% }); %>
    </div>

    <div class="tbl-wrap mb4">
      <table>
        <caption class="sr-only">جدول قیمت لحظه‌ای نمادهای مالی</caption>
        <thead><tr><th>نماد</th><th class="ta-l">قیمت آخر</th><th class="ta-l">تغییر</th><th class="ta-l">درصد</th><th class="ta-l">کمترین</th><th class="ta-l">بیشترین</th><th class="ta-l">روند ۲۴ ساعت</th><th class="ta-l">بروزرسانی</th></tr></thead>
        <tbody>
          <% rows.forEach(function (f) {
               var sp = sparkPath(f.hist, 64, 20, 3);
               var up = trendDir(f.hist) >= 0;
          %>
          <tr>
            <td class="td-name"><%= f.name || f.symbol %></td>
            <td class="ta-l"><%= fa(f.priceText) %><% if (f.unitText !== 'تومان') { %><span class="tick-unit"><%= f.unitText %></span><% } %></td>
            <td class="ta-l <%= f.change > 0 ? 'up' : (f.change < 0 ? 'down' : '') %>"><%= (f.change > 0 ? '+' : f.change < 0 ? '−' : '') + fa(num(Math.abs(f.change || 0))) %></td>
            <td class="ta-l"><span class="badge <%= f.change_pct > 0 ? 'badge-up' : (f.change_pct < 0 ? 'badge-down' : 'badge-flat') %>"><%= pct(f.change_pct) %></span></td>
            <td class="ta-l"><%= fa(num(f.low)) %></td>
            <td class="ta-l"><%= fa(num(f.high)) %></td>
            <td class="ta-l">
              <% if (sp) { %>
              <svg class="spark" viewBox="0 0 64 20"><path d="<%= sp %>" fill="none" stroke="<%= up ? '#4ade80' : '#f87171' %>" stroke-width="1.5" stroke-linejoin="round"/></svg>
              <% } else { %><span class="dim">—</span><% } %>
            </td>
            <td class="ta-l"><%= timeAgo(f.timestamp) %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (goldRows.length) { %>
    <div class="page-head between wrap">
      <h2 class="sec-title">ترند قیمت پلتفرم‌های طلا</h2>
      <div class="row wrap" style="gap:6px;">
        <span class="badge badge-down">زنده</span>
        <% if (goldUpdated) { %><span class="tag">بروزرسانی <%= timeAgo(goldUpdated) %></span><% } %>
      </div>
    </div>

    <blockquote class="desc">
      قیمت خرید هر گرم طلای ۱۸ عیار در پلتفرم‌های آنلاین، هر ۱۰ دقیقه مستقیماً از خود سایت‌ها خوانده می‌شود.
      ارزان‌ترین پلتفرم «کف بازار» نام می‌گیرد و اختلاف بقیه نسبت به همان سنجیده می‌شود.
      این ارقام قیمت اعلامی هر پلتفرم است و کارمزد، اجرت یا شرایط خرید در آن لحاظ نشده —
      پیش از خرید، صفحه‌ی خود پلتفرم را ببینید.
    </blockquote>

    <div class="grid g4 mb4">
      <div class="kpi"><div class="kpi-label">کف بازار</div>
        <div class="kpi-val up"><%= fa(num(goldRows[0].price)) %></div>
        <div class="kpi-note"><%= goldRows[0].name_fa %> · تومان بر گرم</div></div>
      <div class="kpi"><div class="kpi-label">سقف بازار</div>
        <div class="kpi-val down"><%= fa(num(goldRows[goldRows.length - 1].price)) %></div>
        <div class="kpi-note"><%= goldRows[goldRows.length - 1].name_fa %></div></div>
      <div class="kpi"><div class="kpi-label">دامنه‌ی اختلاف</div>
        <div class="kpi-val"><%= fa(num(goldSpread)) %></div>
        <div class="kpi-note">فاصله‌ی گران‌ترین تا ارزان‌ترین</div></div>
      <div class="kpi"><div class="kpi-label">پلتفرم رصد‌شده</div>
        <div class="kpi-val"><%= fa(goldRows.length) %></div>
        <div class="kpi-note">هر ۱۰ دقیقه بروزرسانی</div></div>
    </div>

    <% if (goldChart) { %>
    <section class="panel mb4">
      <div class="panel-head">
        <h3 class="panel-title">روند ۲۴ ساعت گذشته</h3>
        <span class="panel-link"><%= fa(num(goldChart.vMin)) %> تا <%= fa(num(goldChart.vMax)) %> تومان</span>
      </div>
      <div class="panel-body-pad">
        <svg class="gold-chart" viewBox="0 0 600 180" preserveAspectRatio="none" role="img" aria-label="روند قیمت طلا در پلتفرم‌ها">
          <% goldChart.lines.forEach(function (l) { %>
          <polyline points="<%= l.d %>" fill="none" stroke="hsl(<%= l.hue %> 70% 55%)" stroke-width="1.6"
                    stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
          <% }); %>
        </svg>
        <div class="gold-legend">
          <% goldChart.lines.forEach(function (l) { %>
          <span class="gold-key"><i style="background:hsl(<%= l.hue %> 70% 55%)"></i><%= l.name_fa %></span>
          <% }); %>
        </div>
      </div>
      <div class="panel-foot">محور عمودی روی بازه‌ی مشترک همه‌ی پلتفرم‌ها کشیده شده تا اختلافشان قابل مقایسه باشد.</div>
    </section>
    <% } %>

    <div class="tbl-wrap mb6">
      <table>
        <thead><tr><th>برند</th><th class="ta-l">قیمت خرید (تومان)</th><th class="ta-l">اختلاف با کف بازار</th><th class="ta-l">وضعیت</th><th class="ta-l">صفحه</th></tr></thead>
        <tbody>
          <% goldRows.forEach(function (g) { %>
          <tr>
            <td class="td-name">
              <span class="row" style="gap:8px;">
                <% if (g.logo) { %><img class="gold-logo" src="<%= g.logo %>" alt="<%= g.name_fa %>" loading="lazy" width="40" height="40"><% } %>
                <%= g.name_fa %>
              </span>
            </td>
            <td class="ta-l"><%= fa(num(g.price)) %></td>
            <td class="ta-l"><% if (g.isFloor) { %><span class="dim">—</span><% } else { %>+<%= fa(num(g.diff)) %><% } %></td>
            <td class="ta-l">
              <% if (g.isFloor) { %><span class="badge badge-up">کف بازار · کمترین قیمت</span>
              <% } else if (g.isTop) { %><span class="badge badge-down">سقف قیمت</span>
              <% } else { %><span class="badge badge-flat">مناسب</span><% } %>
            </td>
            <td class="ta-l"><a class="btn btn-sm" href="<%= g.url %>" target="_blank" rel="nofollow noopener">مشاهده ↗</a></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>

    <section class="panel">
      <div class="panel-head">
        <h2 class="panel-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
          کانال‌های تلگرامی — کف بازار
        </h2>
        <span class="panel-link"><%= fa(channels.length) %> کانال رصد می‌شود</span>
      </div>
      <div class="panel-body-flush">
        <% messages.forEach(function (m) { %>
        <div class="nrow">
          <div class="nrow-body">
            <div class="nrow-text"><%= excerpt(clean(m.text_fa || m.text), 190) %></div>
            <div class="nrow-meta">
              <% if (m.channel_photo) { %><img class="avatar" src="<%= m.channel_photo %>" alt="<%= m.channel_title %>" width="20" height="20" loading="lazy"><% } else { %><span class="avatar"></span><% } %>
              <span class="nrow-src"><%= m.channel_title || m.channel_username || '' %></span>
              <% if (m.lang && m.lang !== 'fa' && m.text_fa) { %><span class="badge badge-acc">ترجمه</span><% } %>
              <span class="dot-sep">·</span><%= timeAgo(m.published_at) %>
            </div>
          </div>
        </div>
        <% }); %>
        <% if (!messages.length) { %><div class="sentinel"><div class="sentinel-txt">پیامی برای نمایش نیست.</div></div><% } %>
      </div>
      <div class="panel-foot">منابع غیرفارسی خودکار ترجمه می‌شوند</div>
    </section>

  </div>
</main>
