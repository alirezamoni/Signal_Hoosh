<%
  var m = mediaOf(n.media_url);
  var isVideo = n.media_type === 'video' || n.media_type === 'gif';
  var hot = n.hot === true;
%>
<a class="nrow<%= hot ? ' nrow-hot' : '' %>" href="/news/<%= n.id %>">
  <% if (m.first || isVideo) { %>
  <div class="nrow-media">
    <% if (m.first) { %>
    <img class="nrow-thumb" src="<%= m.first %>" alt="<%= excerpt(n.text_fa || n.text, 60) %>" width="84" height="60" loading="lazy">
    <% } else { %>
    <span class="nrow-thumb"></span>
    <% } %>
    <% if (m.count > 1) { %>
    <span class="media-badge"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16v12H4z" opacity=".6"/><path d="M8 8h16v12H8z"/></svg><%= fa(m.count) %></span>
    <% } else if (isVideo) { %>
    <span class="media-badge"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 5h16v14H4z" opacity=".5"/><path d="M10 8l6 4-6 4z"/></svg>ویدیو</span>
    <% } %>
  </div>
  <% } %>
  <div class="nrow-body">
    <div class="nrow-text"><%= excerpt(n.text_fa || n.text, 190) %></div>
    <div class="nrow-meta">
      <% if (n.channel_photo) { %>
      <img class="avatar" src="<%= n.channel_photo %>" alt="<%= n.channel_title %>" width="20" height="20" loading="lazy">
      <% } else { %><span class="avatar"></span><% } %>
      <span class="nrow-src"><%= n.channel_title || n.channel_username || 'نامشخص' %></span>
      <% if (n.lang && n.lang !== 'fa' && n.text_fa) { %><span class="badge badge-acc">ترجمه</span><% } %>
      <% if (hot) { %><span class="badge badge-down">داغ</span><% } %>
      <span class="dot-sep">·</span><%= timeAgo(n.published_at) %>
    </div>
  </div>
</a>
