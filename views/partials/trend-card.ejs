<a class="hot-card" href="https://www.google.com/search?q=<%= encodeURIComponent(t.keyword) %>" target="_blank" rel="noopener">
  <div class="hot-top">
    <div class="hot-rank"><%= fa(String(rank).padStart(2, '0')) %></div>
    <div class="hot-kw"><%= t.keyword %></div>
  </div>

  <div class="hot-chart">
    <% if (t.curveLine) { %>
    <svg class="hot-spark" viewBox="0 0 128 48" preserveAspectRatio="none" role="img" aria-label="نمودار میل به جستجو">
      <polyline points="<%= t.curveFill %>" fill="url(#trend-grad)" stroke="none"></polyline>
      <polyline points="<%= t.curveLine %>" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linejoin="round" vector-effect="non-scaling-stroke"></polyline>
    </svg>
    <% } %>
  </div>

  <% if (t.breakdown && t.breakdown.length) { %>
  <div class="hot-breakdown">
    <% t.breakdown.slice(0, 2).forEach(function (b) { %><span class="chip-sm"><%= b %></span><% }); %>
    <% if (t.breakdownMore) { %><span class="chip-sm chip-more">+<%= fa(t.breakdownMore) %></span><% } %>
  </div>
  <% } %>

  <div class="hot-meta">
    <span class="hot-vol"><%= fa(t.vol || 0) %><%= t.unit || '' %></span>
    <span class="hot-meta-l">
      <% if (t.cat) { %><span class="tag"><%= t.cat %></span><% } %>
      <% if (t.growth) { %><span class="badge badge-up">+<%= fa(t.growth) %>٪</span><% } %>
    </span>
  </div>
</a>
